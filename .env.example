# For local full-stack development, use `vercel dev` and set VITE_DEMO_MODE=false.
APP_ORIGIN=http://localhost:3000
AUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback
SESSION_ENCRYPTION_KEY=generate-a-random-32-byte-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret-value
MICROSOFT_TENANT_ID=common
VITE_DEMO_MODE=false
